# Copy to /etc/tender/tender.env on the VM. Never commit the real file.
POSTGRES_USER=tender
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=tender
POSTGRES_PORT=5433

RAG_POSTGRES_USER=rag
RAG_POSTGRES_PASSWORD=change-me-another-long-random-password
RAG_POSTGRES_DB=rag
RAG_POSTGRES_PORT=5434

ADMIN_EMAIL=admin@tender.local
ADMIN_PASSWORD=change-me-admin-password

# The browser uses the host it was opened from. These can stay empty without a domain.
PUBLIC_BACKEND_URL=
PUBLIC_RAG_URL=
PUBLIC_FETCH_DOCUMENT_PROXY_URL=
CORS_ALLOWED_ORIGINS=http://85.116.182.35,http://85.116.182.35:8082

TENDERPLUS_URL=https://api.tenderplus.kz/graphql
TENDERPLUS_TOKEN=
TENDERS_KEYWORDS=
FETCH_DOCUMENT_ALLOWED_HOSTS=v3bl.goszakup.gov.kz,goszakup.gov.kz,zakup.gov.kz,ows.goszakup.gov.kz,api.tenderplus.kz,.tenderplus.kz

AI_PROVIDER=gemini
LOT_ANALYZE_AI_PROVIDER=gemini
SPEC_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHAT_MODEL=gemini-2.5-flash
LOT_ANALYZE_CHAT_MODEL=gemini-2.5-flash
SPEC_CHAT_MODEL=gemini-2.5-flash

# Local Ollama fallback. qwen2.5:14b fits the current NVIDIA L40S.
GROQ_API_KEY=ollama
GROQ_BASE_URL=http://llm:11434/v1
GROQ_API_BASE=http://llm:11434/v1
GROQ_MODEL=qwen2.5:14b
CLOUDY_AI_PROVIDER=groq
CLOUDY_CHAT_MODEL=qwen2.5:14b
OLLAMA_KEEP_ALIVE=24h
LLM_PORT=11434

COMPANY_PROFILE=
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Parser runs continuously and starts a new cycle every 30 minutes.
PARSER_POLL_INTERVAL_SECONDS=1800
PARSER_MAX_WORKERS=2
PARSER_MAX_LOTS_PER_CYCLE=10
PARSER_STOP_AT_FIRST_SEEN_LOT=true
PARSER_PROCESS_EXISTING_LOTS=false
PARSER_GOSZAKUP_LOTS_MAX_PAGES=3
PARSER_ZAKUP_LOTS_MAX_PAGES=3
PARSER_AI_LOT_FILTER_ENABLED=true
PARSER_REQUEST_TIMEOUT_SECONDS=30

PLATFORMS=tenderplus
DEFAULT_KEYWORDS=
OUR_BINS=
STRICT_KEYWORD_FILTER=false
COLLECT_ALL_ACTIVE_LOTS=true
SEMANTIC_MATCH_ENABLED=false
AI_LOT_FILTER_MIN_SCORE=65
AI_REQUEST_DELAY_SECONDS=5
AI_RATE_LIMIT_COOLDOWN_SECONDS=300

TENDERPLUS_PAGE_SIZE=25
TENDERPLUS_MAX_PAGES=2
TENDERPLUS_MAX_LOTS=50
TENDERPLUS_INCLUDE_DOCUMENTS=true
TENDERPLUS_DOCUMENT_MAX_DOWNLOADS=2
TENDERPLUS_RAG_INDEX_DOCUMENTS=false

GOSZAKUP_OWS_TOKEN=
GOSZAKUP_OWS_BASE_URL=https://ows.goszakup.gov.kz
GOSZAKUP_OWS_GRAPHQL_URL=https://ows.goszakup.gov.kz/v3/graphql
ZAKUP_PUBLIC_BASE_URL=https://zakup.gov.kz
ZAKUP_LOTS_URL=https://zakup.gov.kz/home/lots
ZAKUP_LOTS_LIMIT=100
ZAKUP_LOTS_SYSTEM_IDS=
ZAKUP_OWS_MAX_PAGES_PER_KEYWORD=0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Existing production volume names. The bootstrap script creates them on a new VM.
TENDER_POSTGRES_VOLUME=cloud-user_tender_postgres_data
RAG_POSTGRES_VOLUME=cloud-user_rag_postgres_data
PARSER_DOWNLOADS_VOLUME=cloud-user_parser_downloads
OLLAMA_VOLUME=cloud-user_ollama_data
