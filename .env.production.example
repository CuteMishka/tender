# Copy to /home/cloud-user/tender1/.env and keep the file mode at 0600.
# Never reuse the example values in production.
POSTGRES_USER=tender
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tender

RAG_POSTGRES_USER=rag
RAG_POSTGRES_PASSWORD=change-me-rag-password
RAG_POSTGRES_DB=rag

# These three ports are bound to 127.0.0.1 by docker-compose.prod.yml.
BACKEND_INTERNAL_PORT=8082
RAG_PORT=8083
FRONTEND_PORT=18080
EMBEDDING_MODEL=intfloat/multilingual-e5-small

PUBLIC_BACKEND_URL=https://qolab.kz
PUBLIC_RAG_URL=https://qolab.kz/api/v1/rag
CORS_ALLOWED_ORIGINS=https://qolab.kz,https://www.qolab.kz

# Browser sessions are server-side. Generate the two internal service tokens
# independently (for example, `openssl rand -hex 32` twice). Never reuse one
# value for both trust boundaries.
AUTH_COOKIE_NAME=tender_session
AUTH_CSRF_COOKIE_NAME=tender_csrf
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
AUTH_SESSION_TTL=12h
AUTH_SESSION_TOUCH_INTERVAL=5m
AUTH_ALLOWED_HOSTS=qolab.kz,www.qolab.kz,127.0.0.1,localhost,backend
AUTH_ALLOWED_ORIGINS=https://qolab.kz,https://www.qolab.kz
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12
AUTH_LOGIN_ACCOUNT_RATE_LIMIT=5
AUTH_LOGIN_IP_RATE_LIMIT=60
AUTH_LOGIN_RATE_WINDOW=15m
AUTH_REGISTER_RATE_LIMIT=10
AUTH_REGISTER_RATE_WINDOW=1h
BACKEND_INTERNAL_SERVICE_TOKEN=replace-with-a-distinct-64-character-hex-value
RAG_INTERNAL_SERVICE_TOKEN=replace-with-a-different-64-character-hex-value

TENDERPLUS_URL=https://api.tenderplus.kz/graphql
TENDERPLUS_TOKEN=your_tenderplus_token
TENDERS_KEYWORDS=кибербезопасность,ОЦИБ,EDR,пентест,аудит безопасности,сервер,облако,виртуализация,backup
FETCH_DOCUMENT_ALLOWED_HOSTS=v3bl.goszakup.gov.kz,goszakup.gov.kz,zakup.gov.kz,ows.goszakup.gov.kz,api.tenderplus.kz,.tenderplus.kz

AI_PROVIDER=gemini
LOT_ANALYZE_AI_PROVIDER=gemini
SPEC_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=local-llm
RAG_GROQ_BASE_URL=http://llm:11434/v1
GROQ_API_BASE=http://llm:11434/v1
CHAT_MODEL=gemini-2.5-flash
LOT_ANALYZE_CHAT_MODEL=gemini-2.5-flash
SPEC_CHAT_MODEL=gemini-2.5-flash
GROQ_MODEL=local-llm
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_IMAGE_TAG=0.30.0
OLLAMA_KEEP_ALIVE=24h
HF_TOKEN=
COMPANY_PROFILE=

POLL_INTERVAL_SECONDS=1800
MAX_WORKERS=4
PLATFORMS=tenderplus
DEFAULT_KEYWORDS=
DEFAULT_STOP_WORDS=
OUR_BINS=
TENDERPLUS_PAGE_SIZE=25
TENDERPLUS_MAX_PAGES=2
TENDERPLUS_MAX_LOTS=50
TENDERPLUS_INCLUDE_DOCUMENTS=true
TENDERPLUS_DOCUMENT_MAX_DOWNLOADS=2
TENDERPLUS_RAG_INDEX_DOCUMENTS=false
GOSZAKUP_OWS_TOKEN=
GOSZAKUP_OWS_BASE_URL=https://ows.goszakup.gov.kz
GOSZAKUP_OWS_GRAPHQL_URL=https://ows.goszakup.gov.kz/v3/graphql
ZAKUP_PUBLIC_BASE_URL=https://zakup.gov.kz
ZAKUP_LOTS_URL=https://zakup.gov.kz/home/lots
STRICT_KEYWORD_FILTER=false
COLLECT_ALL_ACTIVE_LOTS=true
STOP_AT_FIRST_SEEN_LOT=false
PROCESS_EXISTING_LOTS=true
ZAKUP_LOTS_LIMIT=100
ZAKUP_LOTS_MAX_PAGES=0
ZAKUP_LOTS_SYSTEM_IDS=1__2__3
ZAKUP_OWS_MAX_PAGES_PER_KEYWORD=0
SEMANTIC_MATCH_ENABLED=false
AI_LOT_FILTER_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
