# Install as /etc/tender/backup.env with owner root:root and mode 0600.
# Use an S3-compatible repository outside this VM.
RESTIC_REPOSITORY=s3:https://object-storage.example/tender-backups
RESTIC_PASSWORD_FILE=/etc/tender/restic-password
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
BACKUP_DIR=/var/backups/tender/daily
RETENTION_DAYS=14
COMPOSE_PROJECT=tender-prod
